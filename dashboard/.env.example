# Supabase (Frontend - Vite requires VITE_ prefix)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase (Backend - Direct database connection)
DATABASE_URL=postgresql://user:password@host:port/database

# OpenAI API Key
OPENAI_API_KEY=

# Anthropic API Key
ANTHROPIC_API_KEY=

# WhatsApp authorized number
FLACO_NUMERO=

# Google Drive credentials (optional)
GOOGLE_CREDENTIALS_PATH=

# Google Drive folder ID for backups (optional)
GOOGLE_DRIVE_FOLDER_ID=
